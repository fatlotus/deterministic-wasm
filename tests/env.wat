\05\0f\06\03\dd\00\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\a1\7f.\05\11\06\03% \05\0c\03=t\06\03\9e\7f\ba\05\01\06\03\e3\00 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\e4\00\01\05#\0a\03\be\7f\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\ea\00\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\94\7f.\05\11\06\03% \06\03[t\05\0c\06\03\ef\00J\06\03\91\7f\82\05\01\06\03\f0\00 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\f1\00\01\05#\0a\03\b1\7f\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\f7\00\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\87\7f.\05\11\06\03% \06\03[t\05\0c\06\03\fc\00J\06\03\84\7f\82\05\01\06\03\fd\00 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\fe\00\01\05#\0a\03\a4\7f\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\84\01\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\fa~.\05\16\06\03\8b\01\ba\06\03\f5~t\05\22\06\03\8c\01Ju\055;\05\22\06t\055\06=\05\22\06t\03\f3~\9e\05\0c\06\03\89\01\90\06\03\f7~\82\05\01\06\03\91\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\92\01\01\05#\0a\03\90\7f\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\98\01\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\e6~.\05\16\06\03\9f\01\ba\06\03\e1~t\05\22\06\03\a0\01Jv\057:\05\22\06t\057\06>\05\22\06t\05\1c\06;\05\13\06\9e\05\22\06\1f\05\1c?\05\13\06\9e\05\22\06\1f\06\03\de~\9e\05\0c\06\03\9d\01\90\06\03\e3~\82\05\01\06\03\a7\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\a8\01\01\05#\0a\03\fa~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\ae\01\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\d0~.\05\11\06\03% \05\0c\03\91\01t\06\03\ca~\82\05\01\06\03\b7\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\b8\01\01\05#\0a\03\ea~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\be\01\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\c0~.\05\11\06\03% \05\0c\03\9e\01t\06\03\bd~\82\05\01\06\03\c4\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\c5\01\01\05#\0a\03\dd~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\cb\01\e4\05\09=\e5\06\03\b3~.\05\0d\06\03\d1\01\9e\05\10\83\06\03\ae~J\03\d2\01J\03\ae~.\05\14\03\d2\01 \05$\08X\03\ae~\08 \05\0d\06\03\d4\01 \bd\05\13\06t\03\a9~<\05\01\06\03\db\01\90\02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\dc\01\01\05#\0a\03\c6~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\e2\01\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\9c~.\05\11\06\03% \05\0c\03\c2\01t\06\03\99~\82\05\01\06\03\e8\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\e9\01\01\05#\0a\03\b9~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\ef\01\90\05\09=\05\0f\06\e4\05\09\06u\06\03\8f~.\05\11\06\03% \05\0c\03\cf\01t\06\03\8c~\82\05\01\06\03\f5\01 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\fb\01\01\05#\0a\03\a7~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\81\02\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\fd}.\05\11\06\03% \05\0c\03\e1\01t\06\03\fa}\d6\05\01\06\03\87\02 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\88\02\01\05#\0a\03\9a~\08<\052\06f\05#\ac\05\09\06\03t\ac\05\10\c9\05\09\06\08J\03h.\05\0c\06\03\19 \05:\06t\05\0ct\03g\82\05\0f\06\03\8e\02\c8\05\09=\05\0f\06\e4\05\09\06=\06\03\f0}.\05\11\06\03% \05\0c\03\ee\01\90\06\03\ed}\82\05\01\06\03\94\02 \02\0e\00\01\01\00\05\02\ff\ff\ff\ff\03\95\02\01\05#\0a\03\97~\08<\052\06f\05#\ac\05\09\06\03j\ac\05\0c\f4\05:\06t\05\0ct\03gf\05\13\06\03\9a\02J\05#\03\89~<\05\11\03\0c\82\05\0c\03jt\05#\03\0at\052\06\90\05:\06\03v\ac\05\0c\06<\03g\9e\05\10\06\03\18 \06\03h\08.\05\13\06\03\9a\02J\05#\03\89~<\05\11\03\0c\82\05\10\03it\05#\03\0bt\052\06\90\03]\ac\05\10\06\03\18.\06\03h\82\05\17\06\03\9e\